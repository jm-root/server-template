{
  "name": "server-template",
  "version": "1.2.0",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "start": "npx jm-server",
    "cluster": "npx jm-server --cluster",
    "lint": "eslint",
    "lint:fix": "eslint --fix"
  },
  "lint-staged": {
    "**/*.js": [
      "npm run lint:fix",
      "git add"
    ],
    "**/*.ts": [
      "npm run lint:fix",
      "git add"
    ]
  },
  "husky": {
    "hooks": {
      "pre-commit": "lint-staged"
    }
  },
  "dependencies": {
    "config": "^3.2.3",
    "jm-err": "^1.0.8",
    "jm-event": "^2.0.10",
    "jm-ms-core": "^2.2.5",
    "jm-server": "^2.2.3-beta",
    "jm-server-jaeger": "^0.0.4",
    "jm-server-middleware": "^1.0.1",
    "log4js": "^6.1.0"
  },
  "devDependencies": {
    "@typescript-eslint/eslint-plugin": "^8.43.0",
    "@typescript-eslint/parser": "^8.43.0",
    "eslint": "^9.35.0",
    "husky": "^1.2.0",
    "jest": "^23.1.0",
    "lint-staged": "^8.1.0",
    "sequelize-auto": "^0.6.3",
    "typescript": "^5.9.2"
  },
  "jest": {
    "testEnvironment": "node"
  }
}
